Name: main
Entities:
  - TagComponent:
      Tag: main camera
    CameraComponent:
      BackgroundColor: [0, 0, 0, 255]
      # Destination: [0.4, 0.4]
  - Square:
      Side: 100
      Color: [0, 0, 0, 255]
      Index: 1
    TransformComponent:
    Tasks:
      Asynchronous:
        - ColorChangeAnimation:
            Duration: 4000
            From: [255, 0, 0, 255]
            To: [0, 0, 255, 255]
        - Sequential:
          - TranslationAnimation:
              Duration: 1000
              To: [100, 100]
          - TranslationAnimation:
              Duration: 1000
              To: [200, 100]
          - TranslationAnimation:
              Duration: 1000
              To: [200, 200]
          - TranslationAnimation:
              Duration: 1000
              To: [100, 200]
  # - Square:
  #     Side: 32
  #     Color: [255, 255, 255, 255]
  #     Index: 0
  #   TransformComponent:
  #     Position: [38, 0]
  # - Square:
  #     Side: 32
  #     Color: [255, 255, 255, 255]
  #     Index: 2
  #   TransformComponent:
  #     Position: [0, 38]
